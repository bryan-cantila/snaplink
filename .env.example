# Copy to .env and fill in your own values. Never commit .env.
# Production (PostgreSQL via docker-compose):
DATABASE_URL=postgresql+asyncpg://snaplink:snaplink@localhost:5432/snaplink
# Secret used to sign JWTs. Generate one:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-generate-a-random-64-char-hex-string
JWT_EXPIRE_MINUTES=60
# Optional. When set and reachable, redirect lookups are cached here (1h TTL).
# When unset or unreachable, the API silently falls back to the database.
REDIS_URL=
# Public base URL used to build short_url in API responses.
BASE_URL=http://localhost:8000
RATE_LIMIT_ENABLED=true
